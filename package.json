{
  "name": "trainer",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo de Trainer: API Node/Express/Prisma y frontend React.",
  "workspaces": [
    "trainer-backend",
    "trainer-frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace @trainer/backend",
    "dev:frontend": "npm start --workspace @trainer/frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace @trainer/backend",
    "build:frontend": "npm run build --workspace @trainer/frontend",
    "start": "npm run start:backend",
    "start:backend": "npm start --workspace @trainer/backend",
    "migrate:deploy": "npm run migrate:deploy --workspace @trainer/backend",
    "seed": "npm run seed --workspace @trainer/backend"
  }
}
