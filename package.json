{
  "name": "gymhour",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo de Gymhour: API Node/Express/Prisma y frontend React.",
  "workspaces": [
    "gymhour-backend",
    "gymhour-frontend"
  ],
  "overrides": {
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace @gymhour/backend",
    "dev:frontend": "npm start --workspace @gymhour/frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace @gymhour/backend",
    "build:frontend": "npm run build --workspace @gymhour/frontend",
    "start": "npm run start:backend",
    "start:backend": "npm start --workspace @gymhour/backend",
    "migrate:deploy": "npm run migrate:deploy --workspace @gymhour/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace @gymhour/backend",
    "seed": "npm run seed --workspace @gymhour/backend",
    "test:backend": "npm test --workspace @gymhour/backend",
    "audit:tenant": "npm run audit:tenant --workspace @gymhour/backend"
  }
}
