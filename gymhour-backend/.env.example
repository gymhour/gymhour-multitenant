# ============================================================================
# Variables de entorno del backend. Copiar a .env y completar.
#   cp .env.example .env
# El .env real NUNCA se commitea (ver .gitignore de la raíz).
# ============================================================================

# --- Base de datos (Prisma / MySQL) -----------------------------------------
DATABASE_URL="mysql://usuario:password@host:3306/nombre_db"
# Base aislada y descartable. Los tests se niegan a usar DATABASE_URL.
TEST_DATABASE_URL="mysql://usuario:password@host:3306/gymhour_test"

# --- Servidor ---------------------------------------------------------------
# Sin espacios alrededor del "=", dotenv los toma como parte del nombre.
PORT=3000
NODE_ENV=development

# URL del frontend. Se usa en los links de reset de password y en los mails.
FRONTEND_URL="http://localhost:3001"

# Zona horaria para cierres nocturnos, cumpleaños y asistencias.
# Default en código: America/Argentina/Cordoba
TIMEZONE="America/Argentina/Cordoba"

# --- Autenticación ----------------------------------------------------------
# Cadena larga y aleatoria. Generar con: openssl rand -base64 48
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Panel de plataforma: frontend aislado y clave AES-256 para cifrar el secreto TOTP.
PLATFORM_FRONTEND_URL="http://localhost:3001"
# Generar con: openssl rand -base64 32
PLATFORM_MFA_ENCRYPTION_KEY=""

# --- Suscripciones de gimnasios --------------------------------------------
# Gymhour busca o crea los planes en Rebill al iniciar el pago; no hacen falta IDs en el entorno.
REBILL_PUBLIC_KEY=""
REBILL_SECRET_KEY=""
# Opcional; por defecto https://api.rebill.com (sandbox y producción usan la misma URL).
REBILL_API_BASE_URL="https://api.rebill.com"
REBILL_SIGNING_SECRET=""

# Cobro de cuotas a socios con Mercado Pago (ver MERCADOPAGO.md).
# Credenciales de la app "Gymhour" en Mercado Pago Developers (de prueba o de producción).
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# 32 bytes en hex o base64 para cifrar los tokens de los gimnasios. Si cambia, todos tienen que reconectar.
MP_TOKEN_ENCRYPTION_KEY=""
# Secreto de firma de los webhooks de la app.
MP_WEBHOOK_SECRET=""
# URL pública https de la API, sin barra final. Arma la URL de vuelta de OAuth y la de los avisos.
API_PUBLIC_URL=""
# true en el sandbox (cuentas y tokens de prueba). Sin definir en producción.
MP_TEST_MODE=""

# --- Cron jobs --------------------------------------------------------------
# Requerido: sin esta variable los endpoints /cron/* responden 500.
# Se envía como header: Authorization: Bearer <CRON_SECRET>
# Generar con: openssl rand -hex 32
CRON_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST="smtp.ejemplo.com"
SMTP_PORT=587
SMTP_USER="no-reply@ejemplo.com"
SMTP_PASS=""
# Remitente de los mails. Si se omite, se usa SMTP_USER.
SMTP_FROM="Gymhour <no-reply@ejemplo.com>"

# --- Cloudinary (imágenes) --------------------------------------------------
CLOUDINARY_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_SECRET_KEY=""

# --- Asistente IA (OpenAI) -----------------------------------------------
# La clave vive únicamente en el backend. Cada usuario dispone de hasta 100 consultas por mes.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-terra"
AI_MAX_OUTPUT_TOKENS=3000
AI_CONTEXT_MESSAGE_LIMIT=20
AI_MAX_TOOL_ROUNDS=8
