# ============================================================================
# Variables de entorno del backend. Copiar a .env y completar.
#   cp .env.example .env
# El .env real NUNCA se commitea (ver .gitignore de la raíz).
# ============================================================================

# --- Base de datos (Prisma / MySQL) -----------------------------------------
DATABASE_URL="mysql://usuario:password@host:3306/nombre_db"
# Base aislada y descartable. Los tests se niegan a usar DATABASE_URL.
TEST_DATABASE_URL="mysql://usuario:password@host:3306/gymhour_test"

# --- Servidor ---------------------------------------------------------------
# Sin espacios alrededor del "=", dotenv los toma como parte del nombre.
PORT=3000
NODE_ENV=development

# URL del frontend. Se usa en los links de reset de password y en los mails.
FRONTEND_URL="http://localhost:3001"

# Zona horaria para cierres nocturnos, cumpleaños y asistencias.
# Default en código: America/Argentina/Cordoba
TIMEZONE="America/Argentina/Cordoba"

# --- Autenticación ----------------------------------------------------------
# Cadena larga y aleatoria. Generar con: openssl rand -base64 48
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# --- Cron jobs --------------------------------------------------------------
# Requerido: sin esta variable los endpoints /cron/* responden 500.
# Se envía como header: Authorization: Bearer <CRON_SECRET>
# Generar con: openssl rand -hex 32
CRON_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST="smtp.ejemplo.com"
SMTP_PORT=587
SMTP_USER="no-reply@ejemplo.com"
SMTP_PASS=""
# Remitente de los mails. Si se omite, se usa SMTP_USER.
SMTP_FROM="Gymhour <no-reply@ejemplo.com>"

# --- Cloudinary (imágenes) --------------------------------------------------
CLOUDINARY_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_SECRET_KEY=""
# Signing key de Delivery URL Tokens. Las URLs privadas vencen en 15 minutos.
CLOUDINARY_AUTH_TOKEN_KEY=""

# --- Asistente IA (OpenAI) -----------------------------------------------
# La clave vive únicamente en el backend. Cada usuario dispone de hasta 100 consultas por mes.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-terra"
AI_MAX_OUTPUT_TOKENS=3000
AI_CONTEXT_MESSAGE_LIMIT=20
